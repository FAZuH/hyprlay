stateDiagram-v2
    direction TB

    state "installed" as Installed
    state "checking releases/latest" as Checking
    state "up to date" as Current
    state "refused: cargo or system owned path" as Refused
    state "report only, --check" as Reporting
    state "downloading both assets" as Downloading
    state "aborted, nothing replaced" as Aborted
    state "staged and verified" as Staged
    state "hyprlayd swapped" as DaemonSwapped
    state "hyprlay swapped by self-replace" as CliSwapped
    state "LaunchAgent refreshed" as Refreshing
    state "updated, no LaunchAgent present" as NoService
    state "updated" as Updated

    [*] --> Installed
    Installed --> Checking : hyprlay update
    Checking --> Refused : path owned by cargo or package manager
    Checking --> Reporting : --check
    Checking --> Current : tag is not newer
    Checking --> Downloading : newer tag
    Downloading --> Aborted : network or digest failure
    Downloading --> Staged : both digests match

    Staged --> DaemonSwapped : rename hyprlayd
    DaemonSwapped --> CliSwapped : self-replace hyprlay
    CliSwapped --> Refreshing : LaunchAgent installed
    CliSwapped --> NoService : no LaunchAgent
    Refreshing --> Updated : bootout + bootstrap + enable
    NoService --> Updated : prints run hyprlay install
    Updated --> [*]

    note right of Refreshing
        launchctl refuses a label that is already loaded,
        so the update boots it out before bootstrapping again.
    end note
